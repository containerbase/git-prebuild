{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>containerbase/.github"],
  "packageRules": [
    {
      "description": "Handle tag prefix in git repo.",
      "matchDatasources": ["github-tags"],
      "matchPackageNames": ["git/git"],
      "extractVersion": "^v(?<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "description": "Disabled while only git 2.33.0 is built.",
      "matchFileNames": ["renovate.Dockerfile"],
      "enabled": false
    },
    {
      "description": "Keep each test image on its ubuntu release.",
      "matchFileNames": ["test/Dockerfile"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/containerbase/ubuntu"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    }
  ]
}
